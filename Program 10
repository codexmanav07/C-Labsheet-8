#include <iostream>
using namespace std;

class Student {
    string name;
    int roll_no;
    float marks;

public:
    // Function to input details
    void input() {
        cout << "Enter name: ";
        cin >> name;

        cout << "Enter roll number: ";
        cin >> roll_no;

        cout << "Enter marks: ";
        cin >> marks;
    }

    // Function to display details
    void display() {
        cout << "\nStudent Details\n";
        cout << "Name: " << name << endl;
        cout << "Roll Number: " << roll_no << endl;
        cout << "Marks: " << marks;
    }
};

int main() {
    Student s;

    s.input();
    s.display();

    return 0;
}

