#include <iostream>
using namespace std;

// Function to calculate diagonal sum
void diagonalSum(int arr[3][3]) {
    int sum = 0;

    for (int i = 0; i < 3; i++) {
        sum += arr[i][i];
    }

    cout << "Sum of diagonal elements: " << sum;
}

int main() {
    int arr[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    diagonalSum(arr);

    return 0;
}

Output:
Sum of diagonal elements: 15